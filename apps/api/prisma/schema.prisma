generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  CUSTOMER
  ADMIN
  STAFF
}

enum AuthProvider {
  LOCAL
  GOOGLE
  OTP
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ProductCondition {
  NEW
  OPEN_BOX
  REFURBISHED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InventoryTransactionReason {
  INITIAL_STOCK
  RESTOCK
  SALE_ORDER
  ORDER_CANCELLED
  MANUAL_ADJUSTMENT
  DAMAGED_WRITEOFF
  RETURNED
}

enum RefurbishedStatus {
  PURCHASED
  RECEIVED
  INSPECTION_PENDING
  UNDER_INSPECTION
  REFURBISHMENT
  QUALITY_CHECK
  READY_FOR_SALE
  PUBLISHED
  SOLD
}

enum ConditionGrade {
  GRADE_A_EXCELLENT
  GRADE_B_GOOD
  GRADE_C_FAIR
}

enum ServicePricingType {
  FIXED
  STARTING_FROM
  QUOTE_REQUIRED
}

enum RepairBookingStatus {
  SUBMITTED
  DIAGNOSING
  QUOTATION_SENT
  APPROVED
  IN_REPAIR
  QUALITY_TESTING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
  FAILED
}

enum FulfilmentType {
  STORE_PICKUP
  DELIVERY
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  FOLLOWED_UP
  CONVERTED
  CLOSED
}

enum UsedDeviceSubmissionStatus {
  SUBMITTED
  UNDER_EVALUATION
  OFFER_MADE
  ACCEPTED
  ACQUIRED
  REJECTED
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  phone        String?      @unique
  passwordHash String?
  authProvider AuthProvider @default(LOCAL)
  googleId     String?      @unique
  status       UserStatus   @default(ACTIVE)
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userRoles             UserRole[]
  customerProfile       CustomerProfile?
  addresses             Address[]
  orders                Order[]
  enquiries             Enquiry[]
  repairBookings        RepairBooking[]
  repairUpdates         RepairUpdate[]
  inventoryTransactions InventoryTransaction[]
  usedDeviceSubmissions UsedDeviceSubmission[]
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@index([email, status])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        RoleName   @unique
  description String?
  createdAt   DateTime   @default(now())
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model CustomerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  companyName       String?
  gstNumber         String?
  alternatePhone    String?
  preferredLanguage String   @default("en")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  label        String   @default("Home")
  recipient    String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId, active])
  @@map("categories")
}

model Product {
  id              String           @id @default(uuid())
  sku             String           @unique
  slug            String           @unique
  name            String
  brand           String
  model           String
  shortSummary    String?
  description     String
  condition       ProductCondition @default(NEW)
  costPrice       Decimal          @db.Decimal(10, 2)
  sellingPrice    Decimal          @db.Decimal(10, 2)
  mrpPrice        Decimal?         @db.Decimal(10, 2)
  currency        String           @default("INR")
  warrantyMonths  Int              @default(12)
  warrantySummary String?
  featured        Boolean          @default(false)
  status          ProductStatus    @default(DRAFT)
  categoryId      String
  isDemo          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  category           Category               @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  specifications     ProductSpecification[]
  inventory          Inventory?
  orderItems         OrderItem[]
  enquiries          Enquiry[]
  refurbishedDevices RefurbishedDevice[]

  @@index([categoryId, status])
  @@index([brand, status])
  @@index([featured, status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductSpecification {
  id        String @id @default(uuid())
  productId String
  groupName String @default("General")
  key       String
  value     String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_specifications")
}

model Inventory {
  id                String   @id @default(uuid())
  productId         String   @unique
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int      @default(3)
  warehouseLocation String?  @default("Main Showroom")
  updatedAt         DateTime @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@map("inventories")
}

model InventoryTransaction {
  id             String                     @id @default(uuid())
  inventoryId    String
  changeQuantity Int
  previousQty    Int
  resultingQty   Int
  reason         InventoryTransactionReason
  referenceId    String?
  notes          String?
  actorId        String?
  createdAt      DateTime                   @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@map("inventory_transactions")
}

model RefurbishedDevice {
  id                String            @id @default(uuid())
  deviceCode        String            @unique
  slug              String            @unique
  title             String
  brand             String
  model             String
  serialNumber      String            @unique
  processor         String
  ram               String
  storage           String
  display           String
  graphics          String?
  osInstalled       String            @default("Windows 11 Pro")
  batteryHealthPct  Int?
  batteryCycles     Int?
  conditionGrade    ConditionGrade    @default(GRADE_A_EXCELLENT)
  cosmeticNotes     String?
  workPerformed     String?
  warrantyMonths    Int               @default(6)
  warrantyTerms     String?
  acquisitionSource String?
  acquisitionDate   DateTime          @default(now())
  acquisitionCost   Decimal           @db.Decimal(10, 2)
  refurbishmentCost Decimal           @default(0) @db.Decimal(10, 2)
  sellingPrice      Decimal           @db.Decimal(10, 2)
  currency          String            @default("INR")
  status            RefurbishedStatus @default(PURCHASED)
  imageUrls         String[]
  featured          Boolean           @default(false)
  productId         String?
  isDemo            Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  inspections DeviceInspection[]
  orderItems  OrderItem[]
  enquiries   Enquiry[]

  @@index([status, conditionGrade])
  @@index([brand, status])
  @@map("refurbished_devices")
}

model DeviceInspection {
  id                  String   @id @default(uuid())
  deviceId            String
  inspectorName       String
  screenCheck         String
  keyboardTrackpad    String
  portsConnectivity   String
  thermalsFan         String
  batteryHealthReport String
  storageSmartHealth  String
   motherboardBios    String   @default("Passed")
  overallVerdict      String
  passed              Boolean  @default(true)
  notes               String?
  inspectedAt         DateTime @default(now())

  device RefurbishedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, inspectedAt])
  @@map("device_inspections")
}

model UsedDeviceSubmission {
  id                String                     @id @default(uuid())
  reference         String                     @unique
  customerId        String
  brand             String
  model             String
  processor         String
  ram               String
  storage           String
  ageMonths         Int?
  conditionSummary  String
  knownIssues       String?
  expectedPrice     Decimal?                   @db.Decimal(10, 2)
  offeredPrice      Decimal?                   @db.Decimal(10, 2)
  contactPhone      String
  status            UsedDeviceSubmissionStatus @default(SUBMITTED)
  adminNotes        String?
  customerMessage   String?
  convertedDeviceId String?
  isDemo            Boolean                    @default(false)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@map("used_device_submissions")
}

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  iconName    String   @default("Wrench")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@map("service_categories")
}

model Service {
  id                String             @id @default(uuid())
  categoryId        String
  slug              String             @unique
  title             String
  shortSummary      String
  description       String
  iconName          String             @default("Wrench")
  imageUrl          String?
  pricingType       ServicePricingType @default(STARTING_FROM)
  basePrice         Decimal?           @db.Decimal(10, 2)
  currency          String             @default("INR")
  estimatedTurnaround String           @default("24–48 Hours")
  warrantyNote      String?            @default("90-day service warranty on replaced parts")
  featured          Boolean            @default(false)
  active            Boolean            @default(true)
  isDemo            Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  repairBookings RepairBooking[]
  enquiries      Enquiry[]

  @@index([categoryId, active])
  @@map("services")
}

model RepairBooking {
  id                  String              @id @default(uuid())
  reference           String              @unique
  customerId          String?
  serviceId           String?
  customerName        String
  customerEmail       String
  customerPhone       String
  deviceType          String
  brand               String
  model               String
  serialNumber        String?
  issueCategory       String
  issueDescription    String
  preferredDate       DateTime?
  diagnosticSummary   String?
  internalNotes       String?
  estimatedCompletion DateTime?
  status              RepairBookingStatus @default(SUBMITTED)
  isDemo              Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  customer   User?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service    Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  updates    RepairUpdate[]
  quotations RepairQuotation[]

  @@index([customerId, status])
  @@index([status, createdAt])
  @@map("repair_bookings")
}

model RepairUpdate {
  id                     String              @id @default(uuid())
  bookingId              String
  status                 RepairBookingStatus
  customerVisibleMessage String
  internalNote           String?
  actorId                String?
  createdAt              DateTime            @default(now())

  booking RepairBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("repair_updates")
}

model RepairQuotation {
  id                  String          @id @default(uuid())
  bookingId           String
  quotationNumber     String          @unique
  diagnosisDetails    String
  partsBreakdownJson  String
  partsCost           Decimal         @db.Decimal(10, 2)
  labourCost          Decimal         @db.Decimal(10, 2)
  taxAmount           Decimal         @default(0) @db.Decimal(10, 2)
  totalAmount         Decimal         @db.Decimal(10, 2)
  currency            String          @default("INR")
  validUntil          DateTime?
  status              QuotationStatus @default(PENDING_APPROVAL)
  customerResponseNote String?
  respondedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  booking RepairBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@map("repair_quotations")
}

model Order {
  id                  String         @id @default(uuid())
  reference           String         @unique
  customerId          String
  status              OrderStatus    @default(PENDING_CONFIRMATION)
  paymentStatus       PaymentStatus  @default(PENDING)
  fulfilmentType      FulfilmentType @default(STORE_PICKUP)
  subtotal            Decimal        @db.Decimal(10, 2)
  discountAmount      Decimal        @default(0) @db.Decimal(10, 2)
  taxAmount           Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount         Decimal        @db.Decimal(10, 2)
  currency            String         @default("INR")
  shippingRecipient   String
  shippingPhone       String
  shippingAddressText String
  gstNumber           String?
  customerNotes       String?
  adminNotes          String?
  isDemo              Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  customer User        @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([customerId, createdAt])
  @@index([status, paymentStatus])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  productId           String?
  refurbishedDeviceId String?
  itemType            String   @default("PRODUCT")
  productName         String
  productSku          String
  unitPrice           Decimal  @db.Decimal(10, 2)
  costPriceSnapshot   Decimal? @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal  @db.Decimal(10, 2)

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  refurbishedDevice RefurbishedDevice? @relation(fields: [refurbishedDeviceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  provider          String        @default("OFFLINE_OR_PAY_AT_STORE")
  providerReference String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model Enquiry {
  id                  String        @id @default(uuid())
  reference           String        @unique
  customerId          String
  productId           String?
  refurbishedDeviceId String?
  serviceId           String?
  subject             String
  message             String
  contactPhone        String?
  source              String        @default("WEBSITE")
  status              EnquiryStatus @default(NEW)
  internalNotes       String?
  followUpSummary     String?
  followedUpAt        DateTime?
  isDemo              Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer          User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  refurbishedDevice RefurbishedDevice? @relation(fields: [refurbishedDeviceId], references: [id], onDelete: SetNull)
  service           Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([status, createdAt])
  @@map("enquiries")
}

model SiteContent {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String
  contentJson String
  published   Boolean  @default(true)
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@map("site_contents")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  channel    String    @default("IN_APP")
  title      String
  message    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  safeMetadata String?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, entityType, createdAt])
  @@map("audit_logs")
}
