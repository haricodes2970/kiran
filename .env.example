# =============================================================================
# KIRAN'S INFOTECH — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env (or apps/api/.env and apps/web/.env.local) and fill in values.
# Never commit real secrets to version control.
# =============================================================================

# --- Runtime & Demo Mode ---
NODE_ENV=development
DEMO_MODE=true

# --- Backend API ---
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# --- Frontend Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# --- Database (PostgreSQL / Prisma) ---
# Standard PostgreSQL connection string:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kirans_infotech?schema=public"

# --- Authentication & Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-at-least-32-char-random-secret-in-env"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-at-least-32-char-cookie-secret"
ADMIN_BOOTSTRAP_TOKEN="replace-with-one-time-admin-bootstrap-token"

# --- Business Contact & WhatsApp ---
# Placeholder until official Kiran's Infotech business number is confirmed by client
NEXT_PUBLIC_WHATSAPP_NUMBER="919000000000"
NEXT_PUBLIC_BUSINESS_PHONE="+91 90000 00000"
NEXT_PUBLIC_BUSINESS_EMAIL="contact@kiransinfotech.example.com"

# --- Feature Flags (Configurable per Client Decisions) ---
ALLOW_GUEST_REPAIR_BOOKING=false
ONLINE_PAYMENT_ENABLED=false

# --- Optional External Providers (Leave empty in MVP Demo Mode) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

OTP_PROVIDER="mock"
OTP_API_KEY=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@kiransinfotech.example.com"
